        proxy_buffering off;
    }
}
server {
    listen 443 ssl http2;
    server_name paperless.bruiser.online;

    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
    ssl_certificate     /etc/letsencrypt/live/bruiser.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bruiser.online/privkey.pem;

    client_max_body_size 1G;

    location / {
        proxy_pass http://10.182.100.35:8000;
        proxy_http_version 1.1;
