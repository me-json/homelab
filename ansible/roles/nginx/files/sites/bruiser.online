server {
    listen 443 ssl;
    server_name cameras.bruiser.online;

    ssl_certificate /etc/letsencrypt/live/bruiser.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bruiser.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 0;

    location / {
        proxy_pass http://10.182.100.101:5000;
        proxy_http_version 1.1;

        # WebSockets (live view, UI updates)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Stream video straight through instead of buffering it
        proxy_buffering off;
        proxy_request_buffering off;

        # Keep long live views and playback from being cut off
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
server {  
    listen 80;  
    server_name *.bruiser.online;  
    return 301 https://$host$request_uri;  
}
