server {
    listen 443 ssl;
    server_name inventory.bruiser.online;

    ssl_certificate /etc/letsencrypt/live/bruiser.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bruiser.online/privkey.pem;

    # root → search page (no redirect)
    location = / {
        proxy_pass http://10.182.100.45:8001/inventory/find_container;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # everything else → normal datasette
    location / {
        proxy_pass http://10.182.100.45:8001/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}


