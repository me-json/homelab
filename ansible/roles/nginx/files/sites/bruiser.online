upstream ap_garage {
    server 10.182.80.80:443 max_fails=0;
    server 10.182.80.80:443 max_fails=0;
    server 10.182.80.80:443 max_fails=0;
    server 10.182.80.80:443 max_fails=0;
}

upstream ap_apartment {
    server 10.182.80.70:443 max_fails=0;
    server 10.182.80.70:443 max_fails=0;
    server 10.182.80.70:443 max_fails=0;
    server 10.182.80.70:443 max_fails=0;
}

server {  
    listen 443 ssl default_server;  
    server_name _;  
    ssl_certificate /etc/letsencrypt/live/bruiser.online/fullchain.pem;  
    ssl_certificate_key /etc/letsencrypt/live/bruiser.online/privkey.pem;  
    return 444;  
}  

server {
    listen 443 ssl;
    server_name ap-apartment.bruiser.online;

    ssl_certificate /etc/letsencrypt/live/bruiser.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bruiser.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    location / {
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Host 10.182.80.70;
        proxy_set_header Origin https://10.182.80.70;
        proxy_set_header Referer https://10.182.80.70$request_uri;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";
        proxy_redirect https://10.182.80.70/ /;
        sub_filter https://10.182.80.70 https://$host;
        sub_filter_once off;
        sub_filter_types text/css application/javascript text/javascript application/json;
        proxy_pass https://ap_apartment;
        proxy_next_upstream_tries 4;
    }
}

server {
    listen 443 ssl;
    server_name ap-garage.bruiser.online;

    ssl_certificate /etc/letsencrypt/live/bruiser.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bruiser.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    location / {
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Host 10.182.80.80;
        proxy_set_header Origin https://10.182.80.80;
        proxy_set_header Referer https://10.182.80.80$request_uri;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";
        proxy_redirect https://10.182.80.80/ /;
        sub_filter https://10.182.80.80 https://$host;
        sub_filter_once off;
        sub_filter_types text/css application/javascript text/javascript application/json;
        proxy_pass https://ap_garage;
        proxy_next_upstream_tries 4;
   }
}

server {
    listen 443 ssl;
    server_name thermal-1.bruiser.online;

    ssl_certificate /etc/letsencrypt/live/bruiser.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bruiser.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    location / {
        proxy_pass http://10.182.130.40;
        proxy_http_version 1.0;
        proxy_set_header Host 10.182.130.40;
        proxy_set_header Connection close;
        proxy_buffering on;
        proxy_redirect http://10.182.130.40/ /;
    }
}

server {
    listen 443 ssl http2;
    server_name lubelogger.bruiser.online;

    ssl_certificate     /etc/letsencrypt/live/bruiser.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bruiser.online/privkey.pem;

    client_max_body_size 100M;

    location / {
        proxy_pass http://10.182.100.101:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}


server {
    listen 443 ssl http2;
    server_name office.bruiser.online;

    ssl_certificate     /etc/letsencrypt/live/bruiser.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bruiser.online/privkey.pem;

